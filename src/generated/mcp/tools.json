              },
              {
                "type": "array",
                "items": {}
              }
            ]
          },
          "images": {
            "type": "array",
            "description": "Base64-encoded images shared by all questions, in request order. Requires Clef or Clef Flash with vision weights. URLs and data URLs are not supported.",
            "items": {
              "type": "string",
              "format": "byte"
            }
          },
          "questions": {
            "type": "object",
            "description": "Named questions about the shared state. Answers are not passed to later questions.",
            "minProperties": 1,
            "maxProperties": 64,
            "propertyNames": {
              "pattern": "\\S"
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "title": "Choice",
                  "type": "object",
                  "required": ["type", "instructions", "criteria"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["choice"]
                    },
                    "instructions": {
                      "description": "A nonempty string, or an object or array serialized as JSON text. Not interpreted as chat messages or multimodal input.",
                      "oneOf": [
                        {
                          "type": "string",
                          "pattern": "\\S"
                        },
                        {
                          "type": "object",
                          "additionalProperties": true
                        },
                        {
                          "type": "array",
                          "items": {}
                        }
                      ]
                    },
                    "criteria": {
                      "type": "object",
                      "description": "Option keys mapped to descriptions. A null description uses the key itself. Keys must not be blank; ties follow the model's option order.",
                      "minProperties": 2,
                      "maxProperties": 26,
                      "propertyNames": {
                        "pattern": "\\S"
                      },
                      "additionalProperties": {
                        "type": ["string", "null"]
                      }
                    }
                  }
                },
                {
                  "title": "Noul",
                  "type": "object",
                  "required": ["type", "instructions"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["noul"]
