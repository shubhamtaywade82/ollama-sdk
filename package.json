{
  "name": "@nemesis-oss/ollama-sdk",
  "version": "1.8.0",
  "description": "Production-grade TypeScript SDK for Ollama with native fetch, high availability failover, multi-turn tool calling, structured outputs, reasoning stream tokens, OpenAI/Anthropic bridges, MCP, Web Stream adapters, and a contract-first hybrid architecture that generates TypeScript types, API classes, MCP tools, and Zod schemas from a single canonical IR.",
  "keywords": [
    "ollama",
    "ollama-client",
    "ollama-sdk",
    "llm",
    "ai",
    "typescript",
    "nodejs",
    "chat",
    "streaming",
    "tool-calling",
    "function-calling",
    "agent",
    "mcp",
    "skills",
    "zod",
    "structured-outputs",
    "embeddings",
    "qwen",
    "llama"
  ],
  "license": "MIT",
  "author": "Shubham Taywade <shubhamtaywade82@gmail.com>",
  "homepage": "https://github.com/shubhamtaywade82/ollama-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhamtaywade82/ollama-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/shubhamtaywade82/ollama-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./skills": {
      "import": {
        "types": "./dist/skills.d.ts",
        "default": "./dist/skills.js"
      },
      "require": {
        "types": "./dist/skills.d.cts",
        "default": "./dist/skills.cjs"
      }
    },
    "./package.json": "./package.json",
    "./mcp/stdio": {
      "import": {
        "types": "./dist/mcp-stdio.d.ts",
        "default": "./dist/mcp-stdio.js"
      },
      "require": {
        "types": "./dist/mcp-stdio.d.cts",
        "default": "./dist/mcp-stdio.cjs"
      }
    },
    "./mcp/http": {
      "import": {
        "types": "./dist/mcp-http.d.ts",
        "default": "./dist/mcp-http.js"
      },
      "require": {
        "types": "./dist/mcp-http.d.cts",
        "default": "./dist/mcp-http.cjs"
      }
    },
    "./generated/runtime": {
      "import": {
        "types": "./dist/generated-runtime.d.ts",
        "default": "./dist/generated-runtime.js"
      },
      "require": {
        "types": "./dist/generated-runtime.d.cts",
        "default": "./dist/generated-runtime.cjs"
      }
    },
    "./generated/api": {
      "import": {
        "types": "./dist/generated-api.d.ts",
        "default": "./dist/generated-api.js"
      },
      "require": {
        "types": "./dist/generated-api.d.cts",
        "default": "./dist/generated-api.cjs"
      }
    },
    "./generated/models/schemas": {
      "import": {
        "types": "./dist/generated-models-schemas.d.ts",
        "default": "./dist/generated-models-schemas.js"
      },
      "require": {
        "types": "./dist/generated-models-schemas.d.cts",
        "default": "./dist/generated-models-schemas.cjs"
      }
    },
    "./mcp/generated": {
      "import": {
        "types": "./dist/mcp-generated.d.ts",
        "default": "./dist/mcp-generated.js"
      },
      "require": {
        "types": "./dist/mcp-generated.d.cts",
        "default": "./dist/mcp-generated.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "skills": [
        "dist/skills.d.ts"
      ],
      "mcp/stdio": [
        "dist/mcp-stdio.d.ts"
      ],
      "mcp/http": [
        "dist/mcp-http.d.ts"
      ],
      "generated/runtime": [
        "dist/generated-runtime.d.ts"
      ],
      "generated/api": [
        "dist/generated-api.d.ts"
      ],
      "generated/models/schemas": [
        "dist/generated-models-schemas.d.ts"
      ],
      "mcp/generated": [
        "dist/mcp-generated.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:conformance": "vitest run test/conformance/",
    "verify:edge-runtime": "tsx scripts/verify-edge-runtime.ts",
    "verify:contract-parity": "tsx scripts/verify-contract-parity.ts",
    "contract:fetch": "tsx scripts/fetch-contract.ts",
    "contract:normalize": "tsx scripts/build-contract.ts",
    "contract:validate": "tsx scripts/verify-contract.ts",
    "contract:diff": "tsx scripts/diff-contract.ts",
    "contract:generate": "tsx scripts/generate-contract.ts && prettier --write src/generated/",
    "contract:drift": "tsx scripts/drift-contract.ts",
    "bench": "vitest bench --run",
    "bench:watch": "vitest bench",
    "check:types": "npx --yes @arethetypeswrong/cli@latest --pack .",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run verify:edge-runtime && npm run verify:contract-parity",
    "verify:release": "npm run clean && npm run contract:validate && npm run contract:diff && npm run contract:generate && npm run contract:drift -- --strict && npm run typecheck && npm run lint && npm run test && npm run build && npm run verify:edge-runtime && npm run verify:contract-parity -- --skip-live-docs && npm run check:types",
    "example": "tsx",
    "lab": "tsx lab/run.ts",
    "lab:live": "npm run build && tsx lab/live-tour.ts",
    "prepublishOnly": "npm run verify:release",
    "docs:dev": "cd docs-site && npm run dev",
    "docs:build": "cd docs-site && npm run build",
    "docs:preview": "cd docs-site && npm run preview"
  },
  "peerDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@opentelemetry/api": "^1.9.0",
    "zod": "^3.22.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@modelcontextprotocol/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@edge-runtime/primitives": "^6.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.39.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^1.30.1",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "js-yaml": "^5.4.2",
    "prettier": "^3.9.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.11",
    "zod": "^4.0.0"
  }
}
